{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acolhemvp2-rc-room-malformed-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "../frontend/build", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api", "/api/*"] },
  "vars": { "TEST_MODE": "true", "ROOM_LINK_ALLOWED_HOSTS": "https://meet.example.test" }
}
