{
  "name": "acolhe-cloudflare-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "check": "tsc --noEmit",
    "indexes": "node scripts/create-indexes.mjs",
    "verify": "npm run check && wrangler deploy --dry-run",
    "deploy": "npm run build:frontend && wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "mongodb": "^6.19.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
