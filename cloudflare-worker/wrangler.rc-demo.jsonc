{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "acolhemvp2-demo-20261204",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MONGO_GATEWAY", "class_name": "MongoGateway" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MongoGateway"] }],
  "vars": {
    "APP_ENV": "demo",
    "ROOM_LINK_ALLOWED_HOSTS": "meet.example.test"
  }
}
